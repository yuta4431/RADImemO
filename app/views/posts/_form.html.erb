<%= form_with model: @post do |f| %>
  <%= render 'shared/error_messages', object: f.object %>
  <div class='field mb-4'>
    <%= f.label :program_id, "番組名", class: "form-label" %>
    <%= f.collection_select :program_id, Program.order(:day), :id, :title, 
      { prompt: "番組を選択してください" }, 
      { class: "input input-bordered w-full max-w-lg" } %>
    <div class="mt-2 text-center">
      <%= link_to "番組がない時はこちら 番組登録", new_program_path, class: "text-blue-500 hover:underline text-sm" %>
    </div>
  </div>
  <div class='field mb-4'>
    <%= f.label "放送日時", class: "form-label" %>
    <%= f.date_field :broadcast_date, class: "input input-bordered w-full max-w-xl" %>
  </div>
  <div class="field mb-4">
    <%= f.label "放送内容・感想など" , class: "form-label" %>
    <%= f.text_area :content, class: "input input-bordered w-full max-w-xl", style: "height: 200px;" %>
  </div>
  <div class="field mb-4">
    <div class="flex justify-center">
      <%= f.submit "投稿", class: 'bg-orange-500 hover:bg-orange-600 text-white py-2 px-4 rounded' %>
    </div>
  </div>
<% end %>
