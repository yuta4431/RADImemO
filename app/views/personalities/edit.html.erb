<h1 class="font-bold mb-6 text-center" style="font-size: 2.5rem;">番組情報編集</h1> 
<%= form_with model: @personality, local: true do |f| %>
  <div class='field mb-4'>
    <%= f.label "パーソナリティ名", class: "form-label" %>
    <%= f.text_field :name, class: "input input-bordered w-full max-w-xl" %>
  </div>
  <div class="flex justify-center mb-6">
    <%= f.submit "更新", class: 'btn bg-orange-500 hover:bg-orange-600 text-white' %>
  </div>
<% end %>