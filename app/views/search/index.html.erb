<h1>「 <%= @search_word %> 」 の検索結果</h1>

<% if @no_results %>
  <p>検索結果がありません</p>
<% else %>
  <div>パーソナリティ</div>
  <% if @personalities_results.present? %>
    <% @personalities_results.each do |personality| %>
      <div class="card bg-white shadow-lg rounded-lg overflow-hidden p-8 w-full h-auto">
        <div class="card-body flex flex-col items-center">
          <div class="card-title text-2xl font-bold mb-8">
            <%= link_to personality.name, personality_path(personality), class: "text-blue-500 hover:underline" %>
          </div>
          <div class="text-gray-600 mb-8 text-center">
            <h3 class="text-lg font-semibold">担当番組</h3>
            <% personality.programs.each do |program| %>
              <p><%= link_to program.title, program_path(program), class: "text-blue-500 hover:underline" %></p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <p>パーソナリティの検索結果がありません</p>
  <% end %>

  <div>番組</div>
  <% if @programs_results.present? %>
    <% @programs_results.each do |program| %>
      <div class="card bg-white shadow-lg rounded-lg overflow-hidden p-8 w-full h-auto">
        <div class="card-body">
          <div class="text-2xl font-bold mb-6 text-center">
            <%= link_to program.title, program_path(program), class: "text-blue-500 hover:underline" %>
          </div>
          <div class="text-gray-600 mb-4 text-center">
            パーソナリティ : 
            <% program.personalities.each do |personality| %>
              <%= link_to personality.name, personality_path(personality.id), class: "text-blue-500 hover:underline" %>
            <% end %>
          </div>
          <div class="text-gray-600 mb-8 text-center">
            <%= "放送日時 : #{program.day} #{formatted_time(program.start_time)} 〜 #{formatted_time(program.end_time, is_end_time: true)}" %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <p>番組の検索結果がありません</p>
  <% end %>

  <div>番組メモ</div>
  <% if @posts_results.present? %>
    <% @posts_results.each do |post| %>
      <div class="card bg-white shadow-lg rounded-lg overflow-hidden p-8 w-full h-auto">
        <div class="card-body">
          <div class="text-2xl font-bold mb-8 text-center">
            <%= link_to post.program.title, post_path(post), class: "text-blue-500 hover:underline" %>
          </div>
          <div class="mb-4 text-center">
            <%= "放送日時 : #{l(post.broadcast_date, format: '%Y年%m月%d日 (%a)')}" %>
          </div>
          <div class="mb-8 text-center">
            <%= "放送内容・感想など : #{post.content}" %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <p>番組メモの検索結果がありません</p>
  <% end %>
<% end %>
