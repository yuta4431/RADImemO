<h1 class="font-bold mb-6 text-center" style="font-size: 2.5rem;">パーソナリティ詳細</h1>

<div class="card bg-white shadow-lg rounded-lg overflow-hidden p-8">
  <div class="card-body flex flex-col items-center">
    <div class="card-title text-2xl font-bold mb-8">
      <%= @personality.name %>
    </div>
    <div class="text-gray-600 mb-8 text-center">
      <h3 class="text-lg font-semibold">担当番組</h3>
      <% @personality.programs.each do |program| %>
        <p><%= link_to program.title, program_path(program), class: "text-blue-500 hover:underline" %>
      <% end %>
    </div>
    <div class="mb-2 text-center">
      <%= link_to '編集', edit_personality_path(@personality), class: 'btn text-white', style: 'background-color: #34c759; border-color: #34c759;' %>
      <%= link_to '削除', personality_path(@personality), class: 'btn text-white', style: 'background-color: #ff3b31; border-color: #ff3b31;', data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' } %>
    </div>
  </div>
</div>